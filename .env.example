# Supabase — browser-safe Auth connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — Vercel server only, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Kakao Maps — JavaScript SDK key may be exposed to the browser
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Kakao Places — Vercel server only
KAKAO_REST_API_KEY=

# YouTube Data API v3 — Vercel server only
YOUTUBE_DATA_API_KEY=

# Vercel Cron authentication — Production only
CRON_SECRET=
